{
  "name": "sonuxbox-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/offline-list.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "prerender": "node scripts/prerender.mjs",
    "narration": "vite build --ssr scripts/narration-texts.ts --outDir .narration-build --emptyOutDir && node .narration-build/narration-texts.js | ../tools/narration/.venv/bin/python ../tools/narration/speak.py",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/righteous": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
